<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>smartwizz</ToolCommandName>
    <!-- Namespaced: tool install also queries nuget.org, where a plain "SmartWizz" could be claimed by anyone. -->
    <PackageId>MyCaravam.SmartWizz</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../prompts/code-review.md" LogicalName="code-review.md" />
    <EmbeddedResource Include="../../prompts/review-format.md" LogicalName="review-format.md" />
    <EmbeddedResource Include="../../prompts/standards-review.md" LogicalName="standards-review.md" />
    <EmbeddedResource Include="../../prompts/revalidate.md" LogicalName="revalidate.md" />
  </ItemGroup>

</Project>
