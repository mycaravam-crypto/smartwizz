<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>smartwizz</ToolCommandName>
    <!-- Namespaced: tool install also queries nuget.org, where a plain "SmartWizz" could be claimed by anyone. -->
    <PackageId>MyCaravam.SmartWizz</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartWizz.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- Replace the vulnerable legacy native SQLite dependency (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../prompts/code-review.md" LogicalName="code-review.md" />
    <EmbeddedResource Include="../../prompts/review-format.md" LogicalName="review-format.md" />
    <EmbeddedResource Include="../../prompts/standards-review.md" LogicalName="standards-review.md" />
    <EmbeddedResource Include="../../prompts/revalidate.md" LogicalName="revalidate.md" />
  </ItemGroup>

</Project>
