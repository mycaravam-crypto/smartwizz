{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SmartWizz: check",
      "type": "shell",
      "command": "smartwizz",
      "args": ["check", "--format", "problems"],
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": {
        "owner": "smartwizz",
        "source": "SmartWizz",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(error|warning|info): (.+)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    }
  ]
}
